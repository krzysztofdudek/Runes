{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krzysztofdudek/Runes/grammars/manifest.schema.json",
  "title": "Runes grammar manifest",
  "description": "Pins for the tree-sitter runtime and every grammar the family builds. Runes holds the recipe and the pins, never the WASM bytes; byte identity comes from sha256 and a reproducible build. The same rules are enforced in code by validateGrammarManifest in @chrisdudek/runes/grammars.",
  "type": "object",
  "required": ["schema", "runtime", "grammars"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "runes-grammars/1" },
    "runtime": {
      "description": "The tree-sitter runtime every consumer must load, pinned to an exact version.",
      "type": "object",
      "required": ["package", "version"],
      "additionalProperties": false,
      "properties": {
        "package": { "const": "web-tree-sitter" },
        "version": { "$ref": "#/$defs/exactVersion" }
      }
    },
    "grammars": {
      "type": "array",
      "items": { "$ref": "#/$defs/grammar" }
    }
  },
  "$defs": {
    "exactVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grammar": {
      "type": "object",
      "required": ["language", "wasmFile", "source", "sha256"],
      "additionalProperties": false,
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "Language id, unique in the manifest." },
        "wasmFile": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.wasm$", "description": "File name the parser resolves, unique in the manifest." },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "package", "version", "path"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "npm" },
                "package": { "type": "string", "minLength": 1 },
                "version": { "$ref": "#/$defs/exactVersion" },
                "path": { "type": "string", "minLength": 1, "description": "Path of the WASM inside the package." }
              }
            },
            {
              "type": "object",
              "required": ["kind", "repo", "tag", "asset"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "github-release" },
                "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
                "tag": { "type": "string", "minLength": 1 },
                "asset": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "required": ["kind", "repo", "commit"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "git" },
                "repo": { "type": "string", "minLength": 1 },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "subdir": { "type": "string" }
              }
            }
          ]
        },
        "sha256": {
          "type": "object",
          "required": ["wasm", "nodeTypes"],
          "additionalProperties": false,
          "properties": {
            "wasm": { "$ref": "#/$defs/sha256" },
            "nodeTypes": { "$ref": "#/$defs/sha256" }
          }
        },
        "patches": {
          "type": "array",
          "items": { "type": "string", "pattern": "^patches/[A-Za-z0-9_./-]+\\.patch$" },
          "description": "Patches applied before a source build, relative to grammars/."
        }
      }
    }
  }
}
